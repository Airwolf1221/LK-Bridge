{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "scripts", "test", "deploy/*.mjs", "vitest.config.ts", "vitest.sandbox.config.ts"],
  "exclude": [
    "ui",
    "test/ui",
    "test/review/r4-sessions/idle-tab.test.ts",
    "test/review/r4-sessions/dashboard-401.test.ts"
  ]
}
