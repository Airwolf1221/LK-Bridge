{
  "name": "lk-bridge",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "LegendKeeper v3 API bridge with rate governor, job engine and MCP surface",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\" && npm run build:ui",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p test/ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts --passWithNoTests",
    "soak:sandbox": "tsx scripts/soak-sandbox.ts",
    "spike:v2": "tsx scripts/spike-v2.ts",
    "roundtrip": "tsx scripts/markdown-roundtrip.ts",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "check:drift": "tsx scripts/check-spec-drift.ts",
    "ci": "npm run typecheck && npm run lint && npm run format && npm run gen:registry -- --check && npm run check:drift && npm test",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "db:migrate": "node dist/db/migrate.js",
    "config:check": "node dist/config/check.js",
    "setup:owner": "node dist/auth/cli/setup-owner.js",
    "pat": "node dist/auth/cli/pat.js",
    "projects": "node dist/projects/cli.js",
    "secrets": "node dist/secrets/cli.js",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@legendkeeper/sdk": "^4.1.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.1",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
