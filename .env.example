# Names only. Never commit real values. On the server these live in /etc/lk-bridge/lk-bridge.env (0640).

# --- Server ---
NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8787
BRIDGE_PUBLIC_URL=https://lk.example.invalid
DB_PATH=/var/lib/lk-bridge/bridge.db

# --- LegendKeeper projects (v2 A1; OPS2: optional, projects can be added on the dashboard instead) ---
# Comma-separated project names; each key in LK_PROJECT_<NAME>_API_KEY. Ids are discovered from the keys at start-up.
# A key here is imported into the encrypted secret store (SECRETS_MASTER_KEY) once; the stored key wins after that.
LK_PROJECTS=test
LK_PROJECT_TEST_API_KEY=
LK_DEFAULT_PROJECT=test
# REQUIRE_PROJECT_FOR_WRITES=true   # a write without `project` is refused while several projects are configured
# The deprecated single-project form, used only when LK_PROJECTS is not set:
# LK_API_KEY=
# LK_PROJECT_ID=
# LK_PROJECT_NAME=test
# LK_BASE_URL=            # only to point at a mock LK in tests
LK_READ_ONLY=true         # fail closed; set false deliberately at go-live
LK_ALLOW_MEMBER_ADMIN=false
# LK_TIER_LIMITS={"write-min":120}   # JSON overrides of published tier limits

# --- Governor ---
RESERVE_FLOOR_INTERACTIVE=0.10
RESERVE_FLOOR_JOB=0.25
RESERVE_FLOOR_MAINTENANCE=0.50
# RESERVE_FLOOR_BULK=0.70          # whole-repository passes (P4); unset: 0.70, or the maintenance floor if higher
# The daily tier's own floors (the four above apply to the minute and hour tiers); same order, small on purpose.
# RESERVE_DAY_FLOOR_INTERACTIVE=0.02
# RESERVE_DAY_FLOOR_JOB=0.05
# RESERVE_DAY_FLOOR_MAINTENANCE=0.10
# RESERVE_DAY_FLOOR_BULK=0.15      # bulk may use the day until 85% of it is spent
WRITE_SPACING_MS=500
WRITE_SPACING_STRETCHED_MS=1200

# --- Writers and journal ---
WRITERS_MAX=2
JOURNAL_RETENTION_DAYS=30
JOURNAL_MAX_BYTES=2147483648

# --- MCP ---
MCP_EXPOSE_PER_OP_TOOLS=false
# MCP_RESULT_MAX_CHARS=40000        # larger tool results are stored as a job artefact and returned as a handle
# REFTYPE_BULK_MAX=500              # most Reference Type rows one "Accept all" decides (one request, one transaction)
# INDEX_CLASSIFY_BULK_MAX=500       # most index rows one "Approve all as proposed" decides (one request, one transaction)
# NATION_SUBINDEX_BULK_MAX=500      # most nation children one "Map to a role, for every page with this name" decides
# CHRONOLOGY_CHECK_DELAY_MS=600000  # the chronology check this long after the last edit of a chronology document
# AUTOMATION_BUDGET_MAX_WAIT_SECONDS=600  # an automation run sleeps through a budget wait up to this long, else it stops
# AUTOMATION_CAP_PER_CODE=25        # most pages one automatic code acts on in a run (1-500)
# AUTOMATION_CAP_PER_RUN=100        # most pages all automatic codes act on in a run (1-2000)
# AUTOMATION_RUN_MAX_MINUTES=120    # an automation run stops after this long, pauses included
# SLOW_REQUEST_WARN_MS=30000        # a dashboard request or MCP tool call running this long is logged as a warning
# SLOW_REQUEST_REPEAT_MS=60000      #   and again this often while it runs
# EVENT_LOOP_LAG_WARN_MS=2000       # event-loop delay above this is logged as a warning (task, heap, RSS)
# MEMORY_WARN_FRACTION=0.7          # RSS above this share of MemoryHigh (memory.high) is logged as a warning
# UPLOAD_MAX_BYTES=10485760         # largest image lk_upload_image accepts (base64 or URL)
# UPLOAD_ALLOW_URL_SOURCE=true      # false: no `url` source (base64 and the binary endpoint stay; ChatGPT's `file`
#                                   #   has its own switch, the project setting fileSourceEnabled: ADR 0057 decision 7)
# UPLOAD_FETCH_TIMEOUT_MS=15000     # deadline for fetching an image from a URL
# UPLOAD_PUT_TIMEOUT_MS=120000      # per-attempt deadline of the signed-URL PUT (5000-600000)
# OUTBOUND_EXTRA_PORTS_ALLOWLIST=    # host:port pairs (comma-separated) outbound fetches may use besides 443 (v1.0.1)
# LK_ASSET_HOSTS=assets.legendkeeper.com,assets2.legendkeeper.com   # hosts asset files download from (no key); a
#                                   # download follows a redirect only to one of these (E5.2). Unset: these two. Set:
#                                   # used as it is, so list assets2 too
# ART_CACHE_DIR=                    # v3 F7b: where arkona_get_art keeps its resized images (default: art-cache/ beside DB_PATH)
# ART_CACHE_MAX_MB=                 # v3 F7b: the art cache's cap in MB (default 500); the least recently used go first
# ART_CALL_MAX_IMAGES=              # v3 F7d: the most images one arkona_add_character_art call with groups carries (default 120)
# ART_CALL_MAX_GROUPS=              # v3 F7d: the most groups one such call carries (default 40)

# --- Images (v2 D3; optional, defaults shown; most can be changed on the dashboard's Settings page) ---
# IMAGE_MAX_PIXELS=100000000        # most pixels in an image, every frame together
# IMAGE_MAX_FRAMES=300              # most frames in an animation
# IMAGE_CONVERT_TIMEOUT_MS=60000    # time limit of one conversion
# IMAGE_CONVERT_CONCURRENCY=1       # conversions at once (each holds a decoded image in memory)
# IMAGE_DATA_DIR=                   # the private image directory (default: images/ beside DB_PATH)
# IMAGE_UPLOAD_RATE_PER_PRINCIPAL=1000   # runaway brake: images staged (and binary uploads) per connection per hour
# IMAGE_UPLOAD_RATE_PER_IP=60       # refused (unauthenticated) requests to the binary endpoint per address per hour
# IMAGE_UPLOAD_BODY_TIMEOUT_MS=120000  # deadline for a whole upload body
# IMAGE_UPLOAD_IDLE_TIMEOUT_MS=15000   # longest silence within an upload body
# IMAGE_STAGING_REPORT_DAYS=30      # staged images older than this are reported on the dashboard
# IMAGE_STAGING_MAX_DAYS=90         # an unplaced staged image is removed after this (per project: imageStagingMaxDays)
# IMAGE_STAGING_MIN_FREE_GB=5       # free disk the image store keeps
# IMAGE_STAGED_MAX_BYTES=5368709120   # v3 F7c: staging capacity (5 GiB); an archive entry past it is held
# IMAGE_ARCHIVE_MAX_ENTRIES=300     # v3 F7c: most entries in an image archive (zip)
# IMAGE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648   # v3 F7c: most an archive unpacks to (2 GiB); also its largest file
# ASSET_BYTES_RETENTION_DAYS=90     # how long the bytes kept before an asset delete are kept

# --- Snapshots (v2 E1a; optional, defaults shown) ---
# SNAPSHOT_DIR=                     # the snapshot store (default: snapshots/ beside DB_PATH)
# SNAPSHOT_MIN_FREE_GB=10           # a full snapshot is refused rather than leave less free
# SNAPSHOT_KEEP_FULL_DAYS=30        # every full snapshot is kept this many days
# SNAPSHOT_KEEP_WEEKLY=8            # then one a week for this many weeks
# SNAPSHOT_KEEP_DAYS=30             # change snapshots are kept this many days
# DELETE_COPY_RETENTION_DAYS=90     # the copy kept before an agent's delete (for Revert) is kept this many days
# SNAPSHOT_SOFT_DELETE_DAYS=30      # how long LegendKeeper is taken to keep a deleted page restorable

# --- Encrypted secret store (OPS2): generate with: openssl rand -base64 32 (never change it by hand) ---
SECRETS_MASTER_KEY=
# SECRETS_MASTER_KEY_PREVIOUS=   # only during a rotation (env-sync.sh --rotate-master-key)

# --- Auth (chunk 4). Generate each secret with: openssl rand -base64 48 (two different values) ---
SESSION_SECRET=
JWT_SIGNING_KEY=
# `npm run setup:owner` prints the OWNER_* lines; paste them in with their single quotes.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=      # imported into the encrypted store at the first start; then changed on the dashboard
# OWNER_TOTP_SECRET=      # optional; when set, sign-in also needs an authenticator code (or enrol on the dashboard)
# Optional tuning (defaults shown):
# AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000      # 30 days, renewed on every refresh
# AUTH_REFRESH_FAMILY_MAX_SECONDS=7776000     # 90 days, then sign in again
# AUTH_CODE_TTL_SECONDS=300
# AUTH_SESSION_TTL_SECONDS=2592000             # the dashboard session: 30 days from its last use (ADR 0062)
# AUTH_STEP_UP_WINDOW_SECONDS=43200          # a fresh code for credential changes lasts 12 hours (ADR 0081)
# AUTH_CIMD_TIMEOUT_MS=4000
# AUTH_CIMD_MAX_BYTES=8192
# AUTH_REFRESH_GRACE_SECONDS=10                # 0 disables the refresh-token grace window
# AUTH_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com
# OAUTH_EXTRA_REDIRECT_URIS=                  # exact extra redirect URIs, comma-separated (e.g. a new ChatGPT callback)
# TRUST_PROXY=loopback                        # whose X-Forwarded-For to believe: loopback, none, or IPs/CIDRs

# --- Policy (chunk 2b; optional, defaults shown) ---
# POLICY_PROPOSAL_EXPIRY_DAYS=14             # pending proposals expire after this many days
# POLICY_EXPIRY_SWEEP_SECONDS=300            # how often expiry is checked
# POLICY_PROPOSAL_RETENTION_DAYS=90          # proposal-prune deletes finished proposals this many days old (v1.0.1)

# --- Dashboard (chunk 5; optional, defaults shown) ---
# ADMIN_STREAM_HEARTBEAT_SECONDS=15           # heartbeat of the live stream
# ADMIN_STREAM_REPLAY_EVENTS=500              # events kept for reconnecting dashboards
# ADMIN_BUDGET_PUSH_SECONDS=2                 # budget snapshots pushed to open dashboards

# --- Maintenance scheduler (chunk 6; optional, defaults shown) ---
# MAINTENANCE_ENABLED=true                    # false: nothing runs by itself (Run now still works)
# MAINTENANCE_DEFER_SECONDS=15                # a job that calls LegendKeeper looks again this soon if P1/P2 work is queued
# MAINTENANCE_HISTORY_RUNS=50                 # run records kept per job

# --- Sandbox, soak and spike scripts (v2 A1) ---
# No settings of their own: they take --project <name>, a project registered by the bridge and marked as a sandbox
# (npm run projects -- sandbox <name> on), and use that project's LK_PROJECT_<NAME>_API_KEY.
