# Names only. Never commit real values. On the server these live in /etc/lk-bridge/lk-bridge.env (0640).

# --- Server ---
NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8787
BRIDGE_PUBLIC_URL=https://lk.example.invalid
DB_PATH=/var/lib/lk-bridge/bridge.db

# --- LegendKeeper projects (v2 A1; OPS2: optional, projects can be added on the dashboard instead) ---
# Comma-separated project names; each key in LK_PROJECT_<NAME>_API_KEY. Ids are discovered from the keys at start-up.
# A key here is imported into the encrypted secret store (SECRETS_MASTER_KEY) once; the stored key wins after that.
LK_PROJECTS=test
LK_PROJECT_TEST_API_KEY=
LK_DEFAULT_PROJECT=test
# REQUIRE_PROJECT_FOR_WRITES=true   # a write without `project` is refused while several projects are configured
# The deprecated single-project form, used only when LK_PROJECTS is not set:
# LK_API_KEY=
# LK_PROJECT_ID=
# LK_PROJECT_NAME=test
# LK_BASE_URL=            # only to point at a mock LK in tests
LK_READ_ONLY=true         # fail closed; set false deliberately at go-live
LK_ALLOW_MEMBER_ADMIN=false
# LK_TIER_LIMITS={"write-min":120}   # JSON overrides of published tier limits

# --- Governor ---
RESERVE_FLOOR_INTERACTIVE=0.10
RESERVE_FLOOR_JOB=0.25
RESERVE_FLOOR_MAINTENANCE=0.50
WRITE_SPACING_MS=500
WRITE_SPACING_STRETCHED_MS=1200

# --- Writers and journal ---
WRITERS_MAX=2
JOURNAL_RETENTION_DAYS=30
JOURNAL_MAX_BYTES=2147483648

# --- MCP ---
MCP_EXPOSE_PER_OP_TOOLS=false
# MCP_RESULT_MAX_CHARS=40000        # larger tool results are stored as a job artefact and returned as a handle
# UPLOAD_MAX_BYTES=10485760         # largest image lk_upload_image accepts (base64 or URL)
# UPLOAD_ALLOW_URL_SOURCE=true      # false: no `url` source (base64 and the binary endpoint stay; ChatGPT's `file`
#                                   #   source is still fetched: CR-2026-11-R2, R2-45, ADR 0057 decision 7)
# UPLOAD_FETCH_TIMEOUT_MS=15000     # deadline for fetching an image from a URL
# UPLOAD_PUT_TIMEOUT_MS=120000      # per-attempt deadline of the signed-URL PUT (5000-600000)
# OUTBOUND_EXTRA_PORTS_ALLOWLIST=    # host:port pairs (comma-separated) outbound fetches may use besides 443 (v1.0.1)
# LK_ASSET_HOSTS=assets.legendkeeper.com,assets2.legendkeeper.com   # hosts asset files download from (no key); a
#                                   # download follows a redirect only to one of these (E5.2). Unset: these two. Set:
#                                   # used as it is, so list assets2 too

# --- Encrypted secret store (OPS2): generate with: openssl rand -base64 32 (never change it by hand) ---
SECRETS_MASTER_KEY=
# SECRETS_MASTER_KEY_PREVIOUS=   # only during a rotation (env-sync.sh --rotate-master-key)

# --- Auth (chunk 4). Generate each secret with: openssl rand -base64 48 (two different values) ---
SESSION_SECRET=
JWT_SIGNING_KEY=
# `npm run setup:owner` prints the OWNER_* lines; paste them in with their single quotes.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=      # imported into the encrypted store at the first start; then changed on the dashboard
# OWNER_TOTP_SECRET=      # optional; when set, sign-in also needs an authenticator code (or enrol on the dashboard)
# Optional tuning (defaults shown):
# AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000      # 30 days, renewed on every refresh
# AUTH_REFRESH_FAMILY_MAX_SECONDS=7776000     # 90 days, then sign in again
# AUTH_CODE_TTL_SECONDS=300
# AUTH_SESSION_TTL_SECONDS=43200
# AUTH_CIMD_TIMEOUT_MS=4000
# AUTH_CIMD_MAX_BYTES=8192
# AUTH_REFRESH_GRACE_SECONDS=10                # 0 disables the refresh-token grace window
# AUTH_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com
# OAUTH_EXTRA_REDIRECT_URIS=                  # exact extra redirect URIs, comma-separated (e.g. a new ChatGPT callback)
# TRUST_PROXY=loopback                        # whose X-Forwarded-For to believe: loopback, none, or IPs/CIDRs

# --- Policy (chunk 2b; optional, defaults shown) ---
# POLICY_PROPOSAL_EXPIRY_DAYS=14             # pending proposals expire after this many days
# POLICY_EXPIRY_SWEEP_SECONDS=300            # how often expiry is checked
# POLICY_PROPOSAL_RETENTION_DAYS=90          # proposal-prune deletes finished proposals this many days old (v1.0.1)

# --- Dashboard (chunk 5; optional, defaults shown) ---
# ADMIN_STREAM_HEARTBEAT_SECONDS=15           # heartbeat of the live stream
# ADMIN_STREAM_REPLAY_EVENTS=500              # events kept for reconnecting dashboards
# ADMIN_BUDGET_PUSH_SECONDS=2                 # budget snapshots pushed to open dashboards

# --- Maintenance scheduler (chunk 6; optional, defaults shown) ---
# MAINTENANCE_ENABLED=true                    # false: nothing runs by itself (Run now still works)
# MAINTENANCE_DEFER_SECONDS=15                # a job that calls LegendKeeper looks again this soon if P1/P2 work is queued
# MAINTENANCE_HISTORY_RUNS=50                 # run records kept per job

# --- Sandbox, soak and spike scripts (v2 A1) ---
# No settings of their own: they take --project <name>, a project registered by the bridge and marked as a sandbox
# (npm run projects -- sandbox <name> on), and use that project's LK_PROJECT_<NAME>_API_KEY.
