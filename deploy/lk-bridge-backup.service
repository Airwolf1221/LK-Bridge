# One nightly database backup (started by lk-bridge-backup.timer). Install both files into /etc/systemd/system.
[Unit]
Description=LK-Bridge nightly database backup
Documentation=https://github.com/Airwolf1221/LK-Bridge/blob/main/docs/runbook-deploy.md

[Service]
Type=oneshot
User=lkbridge
Group=lkbridge
ExecStart=/opt/lk-bridge/app/deploy/backup.sh nightly
# Low priority: never compete with the bridge for the disk or CPU.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
UMask=0077
SyslogIdentifier=lk-bridge-backup

# Same hardening as the bridge; this job only reads the database and writes into /var/lib/lk-bridge/backups.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/lk-bridge
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
