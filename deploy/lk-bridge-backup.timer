[Unit]
Description=Nightly LK-Bridge database backup at 04:15 London time

[Timer]
# The zone is part of the expression, so 04:15 stays 04:15 in London across the clock changes.
OnCalendar=*-*-* 04:15:00 Europe/London
# If the server was off at 04:15, run the missed backup shortly after it boots.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
