# LK-Bridge production environment: /etc/lk-bridge/lk-bridge.env  (root:lkbridge, mode 0640)
#
# This template holds names and safe defaults only; it must never contain a real secret, and neither may anything
# committed to the repository. A new file starts as a copy of it (runbook, "The env file"); after that,
# `sudo /opt/lk-bridge/bin/env-sync.sh` keeps the live file in step with each release's template (OPS1, ADR 0024):
# it adds what a release adds, comments out what it removes, and never changes or prints a value you set.
#
# Format: one NAME=value per line, no `export`, no spaces around `=`. systemd reads the file (EnvironmentFile=) and
# strips one pair of single or double quotes. Values that contain `$` (the owner hash) MUST stay in 'single quotes'.
# A line that is `NAME=` with nothing after it is a blank you still have to fill in.
# Lines starting with # are optional settings, shown with their default; remove the # to change one.
#
# Every variable has exactly one marker on the line directly above it, which tells env-sync what to do when the live
# file lacks it (test/unit/deploy-env-template.test.ts keeps them complete):
#   @default             add it with the value shown here
#   @generate:<enc>:<n>  add it with a new random value (<n> bytes from a secure source); also fills a blank line
#   @secret              only the owner can supply it: env-sync adds a commented-out placeholder and says
#                        "ACTION NEEDED". `NAME=` here means required, `# NAME=` optional. Never put a value here.
#   @optional            add it commented out, with its default

# ---------------------------------------------------------------- Server
# @default
NODE_ENV=production
# @default
LOG_LEVEL=info
# The bridge listens on the loopback address only; Caddy is the only way in. Do not change HOST.
# @default
HOST=127.0.0.1
# @default
PORT=8787
# The public address, exactly as clients will use it: https, lowercase, no path, no trailing slash. It is the OAuth
# issuer and the audience of every token, so changing it later signs every client out.
# @default
BRIDGE_PUBLIC_URL=https://lk.ottomoons.co.uk
# Whose X-Forwarded-For to believe. `loopback` is right while Caddy runs on this server.
# @default
TRUST_PROXY=loopback
# The SQLite database. Must be inside /var/lib/lk-bridge: it is the only place the service may write.
# @default
DB_PATH=/var/lib/lk-bridge/bridge.db

# ---------------------------------------------------------------- LegendKeeper projects (v2 A1, OPS2)
# Projects are managed on the dashboard's Projects page (OPS2): add one there by pasting its API key (ADMIN role). The
# bridge checks the key with LegendKeeper first, then keeps it encrypted in its database (see SECRETS_MASTER_KEY
# below), never in this file. Each project's LegendKeeper id is discovered from its key and checked on every start.
# The env-file way is still read: LK_PROJECTS lists names (a lowercase letter first, then lowercase letters, digits or
# underscores), and each project's key goes in LK_PROJECT_<NAME>_API_KEY, the name upper-cased. Such a key is imported
# into the encrypted store at the next start (once, logged by name only); after that the stored key wins, and
# `sudo /opt/lk-bridge/bin/env-sync.sh --retire-imported-keys` comments the env lines out. Keys are secret: never paste
# one anywhere else.
# @optional
# LK_PROJECTS=
# Overrides the default project the dashboard stores ("Make default" on the Projects page) while it is set. Without
# it, the stored default applies (the first project added, until another is made the default). env-sync's
# --retire-default-project comments this line out once the stored default agrees with it.
# @optional
# LK_DEFAULT_PROJECT=
# A write tool called with no `project` is refused while more than one project is configured (keep it on).
# @optional
# REQUIRE_PROJECT_FOR_WRITES=true
# The single-project form of v1, still accepted (with a warning) when LK_PROJECTS is not set: the key, the project id
# it must belong to, and the name it is served as. Do not use it in a new file; see the runbook to move off it.
# @secret
# LK_API_KEY=
# @optional
# LK_PROJECT_ID=
# @optional
# LK_PROJECT_NAME=test
# First boot is read-only. Set to false deliberately, at go-live, after the checks in the runbook (and, per PLAN §9.7,
# only once the old bridge has finished its maintenance and its key is revoked).
# @default
LK_READ_ONLY=true
# Member and invite administration stays off.
# @default
LK_ALLOW_MEMBER_ADMIN=false
# @optional
# LK_TIER_LIMITS={"write-min":120}     # JSON overrides of the published rate-limit tiers
# @optional
# LK_BASE_URL=                         # only to point at a mock LegendKeeper in tests; leave unset in production

# ---------------------------------------------------------------- Governor (leave the defaults unless you have a reason)
# @optional
# RESERVE_FLOOR_INTERACTIVE=0.10
# @optional
# RESERVE_FLOOR_JOB=0.25
# @optional
# RESERVE_FLOOR_MAINTENANCE=0.50
# @optional
# RESERVE_FLOOR_BULK=0.70             # the nightly full snapshot and other whole-repository passes (P4); at least the maintenance floor
# @optional
# WRITE_SPACING_MS=500
# @optional
# WRITE_SPACING_STRETCHED_MS=1200

# ---------------------------------------------------------------- Writers and journal
# One writer for the first week (PLAN §9.7). Can also be changed live on the dashboard (1 to 8).
# @default
WRITERS_MAX=1
# @optional
# JOURNAL_RETENTION_DAYS=30
# @optional
# JOURNAL_MAX_BYTES=2147483648

# ---------------------------------------------------------------- MCP
# @default
MCP_EXPOSE_PER_OP_TOOLS=false
# @optional
# MCP_RESULT_MAX_CHARS=40000
# @optional
# UPLOAD_MAX_BYTES=10485760
# @optional
# UPLOAD_ALLOW_URL_SOURCE=true
# @optional
# UPLOAD_FETCH_TIMEOUT_MS=15000
# @optional
# UPLOAD_PUT_TIMEOUT_MS=120000
# Outbound fetches to hosts other than LegendKeeper (the CIMD client document, an image source URL and its redirects,
# the signed-URL upload PUT) use port 443 only. List exact host:port pairs here, comma-separated, to allow another port.
# @optional
# OUTBOUND_EXTRA_PORTS_ALLOWLIST=

# ---------------------------------------------------------------- Images (v2 D3, ADR 0041)
# Every image is converted to WebP (quality 90) by sharp, one at a time, within these limits. The pixel limit counts
# every frame of an animation together; a file declaring more is refused before anything is decoded.
# @optional
# IMAGE_MAX_PIXELS=100000000
# @optional
# IMAGE_MAX_FRAMES=300
# @optional
# IMAGE_CONVERT_TIMEOUT_MS=60000
# @optional
# IMAGE_CONVERT_CONCURRENCY=1
# The bridge's private image directory: the binary endpoint's temporary files (upload-tmp/, emptied at start-up and every
# minute) and the bytes kept before an asset delete (kept-bytes/). Default: images/ next to DB_PATH, so inside
# /var/lib/lk-bridge, the only place the service may write.
# @optional
# IMAGE_DATA_DIR=
# The binary endpoint (POST /uploads/<upload_id>): a runaway brake per connection per hour (images staged, binary
# uploads and prepare_image_upload calls, each counted on its own; v3 F7c), requests per client address per hour that
# fail authentication or are refused before it, and the time limits of a body (whole, and the longest silence within it).
# @optional
# IMAGE_UPLOAD_RATE_PER_PRINCIPAL=1000
# @optional
# IMAGE_UPLOAD_RATE_PER_IP=60
# @optional
# IMAGE_UPLOAD_BODY_TIMEOUT_MS=120000
# @optional
# IMAGE_UPLOAD_IDLE_TIMEOUT_MS=15000
# Staged images (kept on the bridge's server, never in LegendKeeper) older than this many days are reported on the
# dashboard.
# @optional
# IMAGE_STAGING_REPORT_DAYS=30
# An unplaced staged image older than this many days is removed from the server, a week after the dashboard first
# warned about it (each project can set its own on the Projects page: imageStagingMaxDays).
# @optional
# IMAGE_STAGING_MAX_DAYS=90
# The free disk (GiB) the image store keeps: a new staging upload is refused below it.
# @optional
# IMAGE_STAGING_MIN_FREE_GB=5
# v3 F7c (ADR 0075): the staging capacity, in bytes: the total size of the images staged on the server. An archive entry
# past it is held until space frees; a single upload past it is refused. Default 5 GiB.
# @optional
# IMAGE_STAGED_MAX_BYTES=5368709120
# v3 F7c: image archives (zips): the most entries, and the most bytes every entry unpacks to together (also the largest
# archive file accepted). A larger archive is refused whole.
# @optional
# IMAGE_ARCHIVE_MAX_ENTRIES=300
# @optional
# IMAGE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648
# How long the bytes kept before an asset delete are kept.
# @optional
# ASSET_BYTES_RETENTION_DAYS=90
# The hosts LegendKeeper serves asset files from. The bridge downloads from these only (anonymous GET, no key):
# verifying an upload and keeping the bytes before a delete.
# @optional
# LK_ASSET_HOSTS=assets.legendkeeper.com
# v3 F7b (ADR 0071): where arkona_get_art keeps the resized images it shows inline (a cache: safe to delete). Default:
# art-cache/ next to DB_PATH, so /var/lib/lk-bridge/art-cache, inside the service's ReadWritePaths.
# @optional
# ART_CACHE_DIR=
# The art cache's cap in MB; the least recently used images go first.
# @optional
# ART_CACHE_MAX_MB=500

# ---------------------------------------------------------------- Snapshots (v2 E1a, ADR 0042)
# The snapshot store: content-addressed objects and one manifest per snapshot (docs/adr/0042-snapshots-restore-rehearsal.md
# has the layout). Default: snapshots/ next to DB_PATH, so /var/lib/lk-bridge/snapshots, private to the service user.
# The bytes kept before an asset delete live there too (one store). E1b copies this directory to Google Drive.
# @optional
# SNAPSHOT_DIR=
# A full snapshot is refused (with a message on the dashboard) rather than leave less free space than this, in GiB as
# df -h shows it.
# @optional
# SNAPSHOT_MIN_FREE_GB=10
# Retention. Full snapshots are nightly: every one is kept for SNAPSHOT_KEEP_FULL_DAYS days, then one a week (the latest
# of each ISO week) for SNAPSHOT_KEEP_WEEKLY weeks. Change snapshots (after a bridge write) are kept SNAPSHOT_KEEP_DAYS days.
# @optional
# SNAPSHOT_KEEP_FULL_DAYS=30
# @optional
# SNAPSHOT_KEEP_WEEKLY=8
# @optional
# SNAPSHOT_KEEP_DAYS=30
# How long LegendKeeper is taken to keep a deleted page restorable: a restore of a page deleted more recently undeletes
# it; an older one is recreated from the snapshot.
# @optional
# SNAPSHOT_SOFT_DELETE_DAYS=30

# ---------------------------------------------------------------- Encrypted secret store (OPS2)
# The key that encrypts the secrets the bridge keeps in its database: the LegendKeeper keys (added on the dashboard,
# or imported from this file), the owner's password hash and authenticator secret. env-sync generates it (32 random
# bytes). Never change or remove it by hand: the stored secrets could no longer be read, and the projects and the
# sign-in that need them would stop (the dashboard and the sign-in page say so; nothing else breaks). To rotate it,
# follow the runbook ("Rotating the master key").
# @generate:base64:32
SECRETS_MASTER_KEY=
# Set only by `env-sync.sh --rotate-master-key`: the key before a rotation, which can still open what it sealed until
# `npm run secrets -- rotate-master-key` has re-encrypted everything with SECRETS_MASTER_KEY. Keep it as long as you
# keep database backups taken before the rotation.
# @optional
# SECRETS_MASTER_KEY_PREVIOUS=

# ---------------------------------------------------------------- Sign-in and tokens (secrets)
# Two DIFFERENT random values, each at least 32 characters. Generate each with:  openssl rand -base64 48
# @generate:base64:48
SESSION_SECRET=
# @generate:base64:48
JWT_SIGNING_KEY=
# The owner's sign-in name and first password hash. `npm run setup:owner` prints the hash line (the owner runs it, on
# the server, see the runbook); paste it in with its single quotes. OPS2: at the first start with SECRETS_MASTER_KEY
# the hash (and an authenticator secret, if set) moves into the encrypted store; from then on the password and the
# authenticator app are changed on the dashboard (Account page), and these lines can be retired with env-sync.
# @default
OWNER_USERNAME=owner
# @secret
# OWNER_PASSWORD_HASH=
# @secret
# OWNER_TOTP_SECRET=                   # printed by setup:owner if you enrol an authenticator app; then sign-in needs a code
# @optional
# AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# @optional
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# @optional
# AUTH_REFRESH_FAMILY_MAX_SECONDS=7776000
# @optional
# AUTH_CODE_TTL_SECONDS=300
# @optional
# AUTH_SESSION_TTL_SECONDS=43200
# @optional
# AUTH_CIMD_TIMEOUT_MS=4000
# @optional
# AUTH_CIMD_MAX_BYTES=8192
# @optional
# AUTH_REFRESH_GRACE_SECONDS=10
# @optional
# AUTH_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com
# @optional
# OAUTH_EXTRA_REDIRECT_URIS=           # exact extra redirect URIs, comma-separated (for example a new ChatGPT callback)

# ---------------------------------------------------------------- Policy
# @optional
# POLICY_PROPOSAL_EXPIRY_DAYS=14
# @optional
# POLICY_EXPIRY_SWEEP_SECONDS=300
# Finished proposals (executed, rejected, expired, failed) are deleted this many days after they finished (v1.0.1).
# @optional
# POLICY_PROPOSAL_RETENTION_DAYS=90

# ---------------------------------------------------------------- Dashboard
# @optional
# ADMIN_STREAM_HEARTBEAT_SECONDS=15
# @optional
# ADMIN_STREAM_REPLAY_EVENTS=500
# @optional
# ADMIN_BUDGET_PUSH_SECONDS=2

# ---------------------------------------------------------------- Maintenance scheduler
# @optional
# MAINTENANCE_ENABLED=true
# @optional
# MAINTENANCE_DEFER_SECONDS=15
# @optional
# MAINTENANCE_HISTORY_RUNS=50

# ---------------------------------------------------------------- Sandbox, soak and spike scripts
# v2 A1: there are no sandbox settings any more. The scripts take --project <name>: a project listed above, registered
# by the bridge, and marked as a sandbox (npm run projects -- sandbox <name> on, test worlds only). They use that
# project's own key line and refuse every project that is not marked as a sandbox.
