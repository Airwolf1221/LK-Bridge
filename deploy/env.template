# LK-Bridge production environment: /etc/lk-bridge/lk-bridge.env  (root:lkbridge, mode 0640)
#
# Copy this file to that path and fill in the blanks BY HAND on the server. This template holds names and safe
# defaults only; it must never contain a real secret, and neither may anything committed to the repository.
#
# Format: one NAME=value per line, no `export`, no spaces around `=`. systemd reads the file (EnvironmentFile=) and
# strips one pair of single or double quotes. Values that contain `$` (the owner hash) MUST stay in 'single quotes'.
# A line that is `NAME=` with nothing after it is a blank you still have to fill in.
# Lines starting with # are optional settings, shown with their default; remove the # to change one.

# ---------------------------------------------------------------- Server
NODE_ENV=production
LOG_LEVEL=info
# The bridge listens on the loopback address only; Caddy is the only way in. Do not change HOST.
HOST=127.0.0.1
PORT=8787
# The public address, exactly as clients will use it: https, lowercase, no path, no trailing slash. It is the OAuth
# issuer and the audience of every token, so changing it later signs every client out.
BRIDGE_PUBLIC_URL=https://lk.ottomoons.co.uk
# Whose X-Forwarded-For to believe. `loopback` is right while Caddy runs on this server.
TRUST_PROXY=loopback
# The SQLite database. Must be inside /var/lib/lk-bridge: it is the only place the service may write.
DB_PATH=/var/lib/lk-bridge/bridge.db

# ---------------------------------------------------------------- LegendKeeper (the real project)
# API key (ADMIN role) and project id for the project the bridge manages. Secret: never paste them anywhere else.
LK_API_KEY=
LK_PROJECT_ID=
# First boot is read-only. Set to false deliberately, at go-live, after the checks in the runbook (and, per PLAN §9.7,
# only once the old bridge has finished its maintenance and its key is revoked).
LK_READ_ONLY=true
# Member and invite administration stays off.
LK_ALLOW_MEMBER_ADMIN=false
# LK_TIER_LIMITS={"write-min":120}     # JSON overrides of the published rate-limit tiers
# LK_BASE_URL=                         # only to point at a mock LegendKeeper in tests; leave unset in production

# ---------------------------------------------------------------- Governor (leave the defaults unless you have a reason)
# RESERVE_FLOOR_INTERACTIVE=0.10
# RESERVE_FLOOR_JOB=0.25
# RESERVE_FLOOR_MAINTENANCE=0.50
# WRITE_SPACING_MS=500
# WRITE_SPACING_STRETCHED_MS=1200

# ---------------------------------------------------------------- Writers and journal
# One writer for the first week (PLAN §9.7). Can also be changed live on the dashboard (1 to 8).
WRITERS_MAX=1
# JOURNAL_RETENTION_DAYS=30
# JOURNAL_MAX_BYTES=2147483648

# ---------------------------------------------------------------- MCP
MCP_EXPOSE_PER_OP_TOOLS=false
# MCP_RESULT_MAX_CHARS=40000
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_ALLOW_URL_SOURCE=true
# UPLOAD_FETCH_TIMEOUT_MS=15000
# UPLOAD_PUT_TIMEOUT_MS=120000

# ---------------------------------------------------------------- Sign-in and tokens (secrets)
# Two DIFFERENT random values, each at least 32 characters. Generate each with:  openssl rand -base64 48
SESSION_SECRET=
JWT_SIGNING_KEY=
# The owner's sign-in name and password hash. `npm run setup:owner` prints these lines (the owner runs it, on the
# server, see the runbook); paste the OWNER_PASSWORD_HASH line in with its single quotes.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=
# OWNER_TOTP_SECRET=                   # printed by setup:owner if you enrol an authenticator app; then sign-in needs a code
# AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_REFRESH_FAMILY_MAX_SECONDS=7776000
# AUTH_CODE_TTL_SECONDS=300
# AUTH_SESSION_TTL_SECONDS=43200
# AUTH_CIMD_TIMEOUT_MS=4000
# AUTH_CIMD_MAX_BYTES=8192
# AUTH_REFRESH_GRACE_SECONDS=10
# AUTH_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com
# OAUTH_EXTRA_REDIRECT_URIS=           # exact extra redirect URIs, comma-separated (for example a new ChatGPT callback)

# ---------------------------------------------------------------- Policy
# POLICY_PROPOSAL_EXPIRY_DAYS=14
# POLICY_EXPIRY_SWEEP_SECONDS=300

# ---------------------------------------------------------------- Dashboard
# ADMIN_STREAM_HEARTBEAT_SECONDS=15
# ADMIN_STREAM_REPLAY_EVENTS=500
# ADMIN_BUDGET_PUSH_SECONDS=2
# ADMIN_BUDGET_SAMPLE_SECONDS=10

# ---------------------------------------------------------------- Sandbox script only (deploy/sandbox-test.sh)
# The key and project id of the SANDBOX LegendKeeper project, never the real one. The bridge itself ignores these two;
# only deploy/sandbox-test.sh reads them, and it refuses to run if they equal LK_API_KEY or LK_PROJECT_ID.
LK_SANDBOX_API_KEY=
LK_SANDBOX_PROJECT_ID=
