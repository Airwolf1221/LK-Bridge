# The off-site copy to Google Drive (v2 E1b, ADR 0043): a separate process from the bridge, started by
# lk-bridge-offsite.timer (every quarter hour; the schedule itself is on the dashboard, in the database) and by
# lk-bridge-offsite.path (the dashboard's "Copy now" and "Verify now", and the end of each weekly full snapshot).
# Installed by deploy.sh --update-self with the other units (runbook, "Off-site copy to Google Drive").
[Unit]
Description=LK-Bridge off-site copy to Google Drive (encrypted, rclone)
Documentation=https://github.com/Airwolf1221/LK-Bridge/blob/main/docs/runbook-deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lkbridge
Group=lkbridge
WorkingDirectory=/opt/lk-bridge/app
# The runner reads SECRETS_MASTER_KEY, DB_PATH and the few settings it needs from the env file itself, so nothing is put
# in its environment (and rclone, its child, gets a minimal one of its own).
ExecStart=/opt/lk-bridge/app/deploy/offsite.sh run
# A first upload can take hours; a later one minutes.
TimeoutStartSec=12h
UMask=0077
SyslogIdentifier=lk-bridge-offsite

# Never disturb the bridge: lowest CPU and disk priority, and a memory ceiling well under the bridge's. rclone with four
# transfers and Drive's default 8 MiB chunks stays under about 200 MB; Node under 150 MB.
Nice=15
CPUWeight=20
IOSchedulingClass=idle
MemoryHigh=640M
MemoryMax=768M
TasksMax=128

# Hardening, as the bridge: the network, the app (read-only), /var/lib/lk-bridge (the database, the store, the
# requests), and a private /tmp (the temporary rclone config lives there and goes with it).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/lk-bridge
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
